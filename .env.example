# ─────────────────────────────────────────────────────────────────────────────
# Mira-Exchange — miljovariabler
#
# Genererad ur koden (grep process.env). ALLA namn nedan lases nagonstans i
# repot. Kopiera till .env och fyll i. .env far ALDRIG committas.
#
#   [KRAVS]    tjansten startar eller fungerar inte utan den
#   [VALFRI]   har fallback i koden eller behovs bara for ett delflode
#
# Skarpa varden ligger i Render → Environment. Fraga Christian om access.
# ─────────────────────────────────────────────────────────────────────────────

# ── Kärna / drift ────────────────────────────────────────────────────────────
PORT=3000                       # [VALFRI] Render satter den sjalv
NODE_ENV=development            # [VALFRI]
GIT_COMMIT=                     # [VALFRI] visas i GET /version
RENDER_GIT_COMMIT=              # [VALFRI] satts av Render
RENDER_GIT_BRANCH=              # [VALFRI] satts av Render
RENDER_EXTERNAL_URL=            # [VALFRI] satts av Render

# ── Bubble (datalagret) ──────────────────────────────────────────────────────
BUBBLE_API_KEY=                 # [KRAVS] Data API-nyckel
BUBBLE_BASE_URL=                # [VALFRI] default https://mira-fm.com
BUBBLE_LIVE_BASE=               # [VALFRI] skarp bas nar man kor mot version-test
BUBBLE_ASSIGN_TEMP_WF=assign_temp_password   # [KRAVS for onboarding] backend-wf
BUBBLE_CREATE_USER_WF=create_user_account    # [KRAVS for onboarding] backend-wf
CAROTTE_COMPANY_ID=             # [KRAVS for staff/besok] Carottes egen ClientCompany-id

# ── Auth in mot Mira-Exchange ────────────────────────────────────────────────
MIRA_RENDER_API_KEY=            # [KRAVS] global x-api-key, kravs av requireApiKey
SYNC_SECRET=                    # [KRAVS for /sync/v2] x-sync-secret, UTOVER x-api-key
MIRA_EXCHANGE_API_KEY=          # [VALFRI] alias, aldre namn
MIRAGPT_API_KEY=                # [VALFRI] separat nyckel for GPT-integrationen
PLANNING_ADMIN_TOKEN=           # [KRAVS for admin-block] token som HTML-blocken bar
KITCHEN_ACCESS_CODE=            # [KRAVS for /produktion] kodgrind till koks-iPad

# ── Sessionshemligheter (HMAC) ───────────────────────────────────────────────
# Genereras med: openssl rand -hex 32   ·  byte av en nyckel loggar ut alla i det floodet
VISITOR_SESSION_SECRET=         # [KRAVS for /visitor]
MYPAGE_SESSION_SECRET=          # [KRAVS for Min sida]
LANDLORD_SESSION_SECRET=        # [KRAVS for /fastighet]

# ── Fortnox (F&E, Staff, Group) ──────────────────────────────────────────────
FORTNOX_CLIENT_ID=              # [KRAVS for Fortnox-synk]
FORTNOX_CLIENT_SECRET=          # [KRAVS for Fortnox-synk]
FORTNOX_REDIRECT_URI=           # [KRAVS for OAuth-floodet]
FORTNOX_SCOPE=                  # [VALFRI]
FORTNOX_CONNECTION_IDS=         # [KRAVS] kommaseparerade Bubble-id:n, se handoff/SYNC-KARNAN.md §4
FORTNOX_ORDERS_CONNECTION_IDS=  # [VALFRI] delmangd som ordersynken kor
FORTNOX_DOCS_CONNECTION_IDS=    # [VALFRI] delmangd for PDF-hamtning

# ── Tengella (Housekeeping) ──────────────────────────────────────────────────
TENGELLA_BASE_URL=              # [KRAVS for HK-synk]
TENGELLA_APP_KEY=               # [KRAVS for HK-synk] app-key i header
TENGELLA_CONNECTION_ID=         # [KRAVS] Bubble-id for HK-anslutningen
# ⚠️ FYRA STAVNINGAR AV SAMMA SAK lases i koden. Satt samma varde pa alla fyra
#    tills de enats — se handoff/TENGELLA-HK.md (orgnr-kedjan).
TENGELLA_ORGNO=
TENGELLA_ORGNR=
TENGELLA_ORG_NO=
TENGELLA_DEFAULT_ORGNO=

# ── Intelliplan (Service & People) ───────────────────────────────────────────
INTELLIPLAN_API_BASE=           # [KRAVS for S&P-synk]
INTELLIPLAN_IDP_BASE=           # [KRAVS] token-endpoint
INTELLIPLAN_CLIENT_ID=          # [KRAVS]
INTELLIPLAN_CLIENT_SECRET=      # [KRAVS]
INTELLIPLAN_TENANT=             # [KRAVS]
INTELLIPLAN_SCOPE=              # [VALFRI]

# ── Microsoft Graph (kalender, motesrum) ─────────────────────────────────────
MS_TENANT=                      # [KRAVS for /ms/*]
MS_CLIENT_ID=                   # [KRAVS for /ms/*] delegerat flode
MS_CLIENT_SECRET=               # [KRAVS for /ms/*]
MS_APP_CLIENT_ID=               # [VALFRI] app-only flode
MS_APP_CLIENT_SECRET=           # [VALFRI] app-only flode
MS_REDIRECT_URI=                # [KRAVS for OAuth]
MS_REDIRECT_LIVE=               # [VALFRI]
MS_REDIRECT_DEV=                # [VALFRI]
MS_SCOPE=                       # [VALFRI]

# ── Caspeco (F&E fr.o.m. Q1-27) ──────────────────────────────────────────────
CASPECO_SYSTEM=                 # [VALFRI]
CASPECO_PAT=                    # [VALFRI]
CASPECO_ADMIN_TOKEN=            # [VALFRI]
CASPECO_UNIT_ID=                # [VALFRI]
CASPECO_UNIT_IDS=               # [VALFRI]

# ── SendGrid (all utgaende mail) ─────────────────────────────────────────────
SENDGRID_API_KEY=               # [KRAVS for mail] utan den ar mail-pollern avstangd
EMAIL_FROM=                     # [KRAVS for mail]
EMAIL_FROM_NAME=                # [VALFRI]
PW_RESET_TEMPLATE_ID=           # [KRAVS for losenordsaterstallning]
WELCOME_TEMPLATE_ID=            # [KRAVS for onboarding]
APPROVAL_INVITE_TEMPLATE_ID=    # [KRAVS for offertsignering]
APPROVAL_OTP_TEMPLATE_ID=       # [KRAVS for offertsignering]
APPROVAL_SIGNED_TEMPLATE_ID=    # [KRAVS for offertsignering]
APPROVAL_REMINDER_TEMPLATE_ID=  # [VALFRI]
APPROVAL_REVIEW_INVITE_TEMPLATE_ID=  # [VALFRI] granskar-rollen

# ── SMS (46elks, besokshantering) ────────────────────────────────────────────
ELKS_USERNAME=                  # [KRAVS for SMS]
ELKS_PASSWORD=                  # [KRAVS for SMS]
SMS_FROM=                       # [KRAVS for SMS] avsandarnamn

# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=              # [KRAVS for avtals-OCR och Mira AI]

# ── Bas-URL:er ───────────────────────────────────────────────────────────────
# ⚠️ NIO variabler for i praktiken tva adresser (Bubble-fronten och Render-tjansten).
#    Satt APP_BASE_URL + BASE_URL likadant tills de enats. Skuldpost.
APP_BASE_URL=https://mira-fm.com    # [KRAVS] anvands i mail-lankar
BASE_URL=                           # [VALFRI]
PUBLIC_BASE_URL=                    # [VALFRI]
PUBLIC_API_BASE=                    # [VALFRI] den HTML-blocken anropar
SELF_PUBLIC_BASE_URL=               # [VALFRI]
INTERNAL_SELF_BASE_URL=             # [VALFRI] tjansten anropar sig sjalv i nattjobben
PUBLIC_CHECKIN_URL=                 # [VALFRI] besoksincheckning
PUBLIC_SURVEY_URL=                  # [VALFRI] undersokningslandning

# ── Avsandaruppgifter i mail och PDF ─────────────────────────────────────────
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_WEBSITE=
COMPANY_PRIVACY_URL=
COMPANY_ACCENT=                 # [VALFRI] hex, accentfarg i mailmallar

# ── Ovrigt ───────────────────────────────────────────────────────────────────
ANALYTICS_CONNECTION_IDS=       # [VALFRI] vilka anslutningar artikelanalysen tacker
FORFRAGAN_NOTIFY_EMAIL=         # [VALFRI] vart nya forfragningar notifieras
NIGHTLY_INTERNAL_TIMEOUT_MS=    # [VALFRI] tak for nattjobbens interna anrop
